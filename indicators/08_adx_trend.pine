//@version=5
strategy("ADX Trend Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

// === PARAMETERS ===
adxLen      = input.int(14, "ADX Length")
adxThresh   = input.int(25, "ADX Threshold", minval=15, maxval=40)
diLen       = input.int(14, "DI Length")
slPercent   = input.float(5.0, "Stop Loss %")
tpPercent   = input.float(12.0, "Take Profit %")

// === INDICATORS ===
[diplus, diminus, adxVal] = ta.dmi(diLen, adxLen)

// Strong trend filter
strongTrend = adxVal > adxThresh

// === SIGNALS ===
// Long: +DI crosses above -DI with strong ADX
longCondition  = ta.crossover(diplus, diminus) and strongTrend
// Short: -DI crosses above +DI with strong ADX
shortCondition = ta.crossover(diminus, diplus) and strongTrend

// Exit when trend weakens
exitLong  = ta.crossunder(diplus, diminus) or adxVal < adxThresh * 0.7
exitShort = ta.crossover(diplus, diminus) or adxVal < adxThresh * 0.7

// === EXECUTION ===
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long SL/TP", "Long", stop=close*(1-slPercent/100), limit=close*(1+tpPercent/100))

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short SL/TP", "Short", stop=close*(1+slPercent/100), limit=close*(1-tpPercent/100))

if exitLong
    strategy.close("Long")
if exitShort
    strategy.close("Short")

// === PLOTS ===
plotshape(longCondition, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
