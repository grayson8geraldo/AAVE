//@version=5
// TOURNAMENT WINNER: +17.2% OOS, 19 trades, 1.2/month
strategy("StochRSI Wide [AAVE WINNER]", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

rsiLen=input.int(14,"RSI"), stochLen=input.int(14,"Stoch"), kS=input.int(3,"K"), dS=input.int(3,"D")
emaLen=input.int(30,"Trend EMA"), sl=input.float(5.0,"SL%")/100, tp=input.float(12.0,"TP%")/100
buyZone=input.int(35,"Buy Zone"), sellZone=input.int(65,"Sell Zone")

r = ta.rsi(close, rsiLen)
k = ta.sma(ta.stoch(r,r,r,stochLen), kS)
d = ta.sma(k, dS)
e = ta.ema(close, emaLen)

long  = ta.crossover(k, d) and k < buyZone and close > e
short = ta.crossunder(k, d) and k > sellZone and close < e

if long
    strategy.entry("L", strategy.long)
    strategy.exit("LX","L", stop=close*(1-sl), limit=close*(1+tp))
if short
    strategy.entry("S", strategy.short)
    strategy.exit("SX","S", stop=close*(1+sl), limit=close*(1-tp))

plot(e, "EMA30", color.orange, 2)
plotshape(long, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)

// Info table
var table info = table.new(position.top_right, 1, 3, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(info, 0, 0, "StochRSI Wide", text_color=color.white)
    table.cell(info, 0, 1, "SL: 5% | TP: 12%", text_color=color.yellow)
    table.cell(info, 0, 2, "Backtest: +17.2% OOS", text_color=color.green)
