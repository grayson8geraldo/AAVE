//@version=5
strategy("Ichimoku Cloud Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

// === PARAMETERS ===
tenkanLen  = input.int(9, "Tenkan Length")
kijunLen   = input.int(26, "Kijun Length")
senkouBLen = input.int(52, "Senkou B Length")
displacement = input.int(26, "Displacement")
slPercent  = input.float(5.0, "Stop Loss %")
tpPercent  = input.float(12.0, "Take Profit %")

// === INDICATORS ===
tenkan  = (ta.highest(high, tenkanLen) + ta.lowest(low, tenkanLen)) / 2
kijun   = (ta.highest(high, kijunLen) + ta.lowest(low, kijunLen)) / 2
senkouA = (tenkan + kijun) / 2
senkouB = (ta.highest(high, senkouBLen) + ta.lowest(low, senkouBLen)) / 2

// Cloud top and bottom (current, not displaced for signal generation)
cloudTop    = math.max(senkouA[displacement], senkouB[displacement])
cloudBottom = math.min(senkouA[displacement], senkouB[displacement])

// === SIGNALS ===
// Long: Tenkan crosses above Kijun AND price is above the cloud
longCondition  = ta.crossover(tenkan, kijun) and close > cloudTop
// Short: Tenkan crosses below Kijun AND price is below the cloud
shortCondition = ta.crossunder(tenkan, kijun) and close < cloudBottom

// === EXECUTION ===
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=close*(1-slPercent/100), limit=close*(1+tpPercent/100))

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=close*(1+slPercent/100), limit=close*(1-tpPercent/100))

// === PLOTS ===
plot(tenkan, "Tenkan", color.blue, linewidth=1)
plot(kijun,  "Kijun",  color.red, linewidth=1)
p1 = plot(senkouA, "Senkou A", color.green, offset=displacement)
p2 = plot(senkouB, "Senkou B", color.red,   offset=displacement)
fill(p1, p2, color=senkouA > senkouB ? color.new(color.green, 85) : color.new(color.red, 85))
plotshape(longCondition, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
