//@version=5
strategy("RSI + EMA Cross [AAVE]", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

rsiLen=input.int(14,"RSI"), emaLen=input.int(20,"EMA")
sl=input.float(5.0,"SL%")/100, tp=input.float(12.0,"TP%")/100

r = ta.rsi(close, rsiLen)
e = ta.ema(close, emaLen)
long  = ta.crossover(r, 50) and close > e
short = ta.crossunder(r, 50) and close < e

if long
    strategy.entry("L", strategy.long)
    strategy.exit("LX","L", stop=close*(1-sl), limit=close*(1+tp))
if short
    strategy.entry("S", strategy.short)
    strategy.exit("SX","S", stop=close*(1+sl), limit=close*(1-tp))

plot(e, "EMA20", color.orange, 2)
plotshape(long, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
