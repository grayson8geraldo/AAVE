//@version=5
strategy("Stochastic RSI Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

// === PARAMETERS ===
rsiLen    = input.int(14, "RSI Length")
stochLen  = input.int(14, "Stoch Length")
kSmooth   = input.int(3, "K Smoothing")
dSmooth   = input.int(3, "D Smoothing")
emaLen    = input.int(50, "Trend EMA Length")
obLevel   = input.float(80, "Overbought")
osLevel   = input.float(20, "Oversold")
slPercent = input.float(5.0, "Stop Loss %")
tpPercent = input.float(10.0, "Take Profit %")

// === INDICATORS ===
rsiVal = ta.rsi(close, rsiLen)
stochK = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, stochLen), kSmooth)
stochD = ta.sma(stochK, dSmooth)
emaTrend = ta.ema(close, emaLen)

// === SIGNALS ===
// Long: K crosses above D in oversold zone, price above EMA
longCondition  = ta.crossover(stochK, stochD) and stochK < osLevel and close > emaTrend
// Short: K crosses below D in overbought zone, price below EMA
shortCondition = ta.crossunder(stochK, stochD) and stochK > obLevel and close < emaTrend

// === EXECUTION ===
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=close*(1-slPercent/100), limit=close*(1+tpPercent/100))

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=close*(1+slPercent/100), limit=close*(1-tpPercent/100))

// === PLOTS ===
plot(emaTrend, "Trend EMA", color.orange, linewidth=2)
plotshape(longCondition, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
