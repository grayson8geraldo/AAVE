//@version=5
// Ensemble: StochRSI OR Triple EMA OR MACD
strategy("Ensemble 3-Way [AAVE]", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

sl=input.float(5.0,"SL%")/100, tp=input.float(12.0,"TP%")/100

// StochRSI
r = ta.rsi(close, 14)
k = ta.sma(ta.stoch(r,r,r,14), 3)
d = ta.sma(k, 3)
e50 = ta.ema(close, 50)
s1L = ta.crossover(k, d) and k < 25 and close > e50
s1S = ta.crossunder(k, d) and k > 75 and close < e50

// Triple EMA
e8=ta.ema(close,8), e21=ta.ema(close,21), e55=ta.ema(close,55)
s2L = ta.crossover(e8,e21) and e21 > e55
s2S = ta.crossunder(e8,e21) and e21 < e55

// MACD
[ml, sl2, hist] = ta.macd(close, 12, 26, 9)
s3L = ta.crossover(hist, 0)
s3S = ta.crossunder(hist, 0)

long  = s1L or s2L or s3L
short = s1S or s2S or s3S

if long
    strategy.entry("L", strategy.long)
    strategy.exit("LX","L", stop=close*(1-sl), limit=close*(1+tp))
if short
    strategy.entry("S", strategy.short)
    strategy.exit("SX","S", stop=close*(1+sl), limit=close*(1-tp))

plotshape(long, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
