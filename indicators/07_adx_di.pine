//@version=5
strategy("ADX + DI [AAVE]", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

adxLen=input.int(14,"ADX/DI Length"), thresh=input.int(25,"ADX Threshold")
sl=input.float(5.0,"SL%")/100, tp=input.float(12.0,"TP%")/100

[diP, diM, adxVal] = ta.dmi(adxLen, adxLen)
long  = ta.crossover(diP, diM) and adxVal > thresh
short = ta.crossover(diM, diP) and adxVal > thresh

if long
    strategy.entry("L", strategy.long)
    strategy.exit("LX","L", stop=close*(1-sl), limit=close*(1+tp))
if short
    strategy.entry("S", strategy.short)
    strategy.exit("SX","S", stop=close*(1+sl), limit=close*(1-tp))

plotshape(long, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
