//@version=5
strategy("Bollinger Band Breakout", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

// === PARAMETERS ===
bbLen     = input.int(20, "BB Length", minval=5)
bbMult    = input.float(2.0, "BB Multiplier", minval=0.5, step=0.1)
volLen    = input.int(20, "Volume MA Length", minval=5)
slPercent = input.float(4.0, "Stop Loss %", minval=0.5, step=0.5)
tpPercent = input.float(10.0, "Take Profit %", minval=1.0, step=0.5)

// === INDICATORS ===
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev

// Bandwidth squeeze detection
bandwidth = (upper - lower) / basis
bwSMA     = ta.sma(bandwidth, bbLen)
isSqueeze = bandwidth < bwSMA * 0.75

// Volume confirmation
volMA    = ta.sma(volume, volLen)
highVol  = volume > volMA * 1.5

// === SIGNALS ===
// Long: close breaks above upper band after squeeze with high volume
longCondition  = close > upper and isSqueeze[1] and highVol
// Short: close breaks below lower band after squeeze with high volume
shortCondition = close < lower and isSqueeze[1] and highVol

// === EXECUTION ===
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=close*(1-slPercent/100), limit=close*(1+tpPercent/100))

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=close*(1+slPercent/100), limit=close*(1-tpPercent/100))

// === PLOTS ===
plot(basis, "Basis", color.orange)
plot(upper, "Upper", color.blue)
plot(lower, "Lower", color.blue)
fill(plot(upper), plot(lower), color=isSqueeze ? color.new(color.yellow, 80) : color.new(color.blue, 90))
plotshape(longCondition, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
