//@version=5
strategy("VWAP Mean Reversion", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, initial_capital=200)

// === PARAMETERS ===
vwapLen    = input.int(20, "VWAP-like MA Length", minval=5)
devMult    = input.float(2.0, "Deviation Multiplier", minval=0.5, step=0.1)
rsiLen     = input.int(14, "RSI Confirmation Length")
rsiOB      = input.int(70, "RSI Overbought")
rsiOS      = input.int(30, "RSI Oversold")
slPercent  = input.float(4.0, "Stop Loss %")
tpPercent  = input.float(8.0, "Take Profit %")

// === INDICATORS ===
// Volume-weighted moving average (proxy for VWAP on daily)
typicalPrice = (high + low + close) / 3
vwma_val = ta.vwma(typicalPrice, vwapLen)
vwma_dev = ta.stdev(typicalPrice, vwapLen)

upperBand = vwma_val + devMult * vwma_dev
lowerBand = vwma_val - devMult * vwma_dev

rsiVal = ta.rsi(close, rsiLen)

// Distance from VWMA as percentage
deviation = (close - vwma_val) / vwma_val * 100

// === SIGNALS ===
// Long: price touches lower band + RSI oversold (mean reversion up)
longCondition  = close <= lowerBand and rsiVal < rsiOS
// Short: price touches upper band + RSI overbought (mean reversion down)
shortCondition = close >= upperBand and rsiVal > rsiOB

// Exit at VWMA (mean)
exitLong  = close >= vwma_val and strategy.position_size > 0
exitShort = close <= vwma_val and strategy.position_size < 0

// === EXECUTION ===
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long SL/TP", "Long", stop=close*(1-slPercent/100), limit=close*(1+tpPercent/100))

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short SL/TP", "Short", stop=close*(1+slPercent/100), limit=close*(1-tpPercent/100))

if exitLong
    strategy.close("Long")
if exitShort
    strategy.close("Short")

// === PLOTS ===
plot(vwma_val, "VWMA", color.orange, linewidth=2)
plot(upperBand, "Upper", color.red)
plot(lowerBand, "Lower", color.green)
fill(plot(upperBand), plot(lowerBand), color=color.new(color.purple, 90))
plotshape(longCondition, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
